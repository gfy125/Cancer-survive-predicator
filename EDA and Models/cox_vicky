# Lasso Cox modeling with cleaned data
library(glmnet)
# Remove invalid samples with non-positive survival time
valid_idx <- (clinical$survival_time > 0) & complete.cases(clinical$survival_time, clinical$event) & complete.cases(t(selected_expr))
x <- as.matrix(selected_expr)[valid_idx, ]
y <- Surv(clinical$survival_time[valid_idx], clinical$event[valid_idx])

# Cross-validation
cv_fit <- cv.glmnet(x, y, family = "cox", alpha = 1)
best_lambda <- cv_fit$lambda.min

# Final model
lasso_cox_model <- glmnet(x, y, family = "cox", alpha = 1, lambda = best_lambda)

# Extract selected genes
coef_lasso <- coef(lasso_cox_model)
selected_lasso_genes <- rownames(coef_lasso)[as.numeric(coef_lasso) != 0]
print(selected_lasso_genes)


