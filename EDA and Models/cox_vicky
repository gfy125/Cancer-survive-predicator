# Extract clinical data
clinical <- colData(query2) %>% 
  as.data.frame() %>%
  dplyr::select(gender, vital_status, days_to_death, days_to_last_follow_up, 
               ajcc_pathologic_stage, age_at_diagnosis)

# Create survival object and clean data
clinical <- clinical %>%
  mutate(
    # Define survival time: use days_to_last_follow_up if patient is alive
    survival_time = ifelse(vital_status == "Alive", days_to_last_follow_up / 365, days_to_death / 365),
    event = ifelse(vital_status == "Dead", 1, 0),
    age_diagnosis = age_at_diagnosis / 365
  ) %>%
  mutate(
    age_diagnosis = ifelse(is.na(age_diagnosis), median(age_diagnosis, na.rm = TRUE), age_diagnosis)
  )

# Extract gene expression and apply log2 transformation
fpkm <- assay(query2, "fpkm_uq_unstrand")
log_expr <- log2(fpkm + 1)

# Batch extraction
ids <- as.character(colData(query2)$barcode)
batch <- sapply(strsplit(ids, "-"), function(x) {
  if (length(x) >= 6) return(x[6]) else return(NA)
})

# Filter genes with zero variance
gene_var <- apply(log_expr, 1, var)
log_expr_filtered <- log_expr[gene_var > 0, ]
```

```{r}
# Batch correction using ComBat
modcombat <- model.matrix(~1, data = data.frame(batch = batch))
combat_expr <- ComBat(dat = as.matrix(log_expr_filtered),
                      batch = batch,
                      mod = modcombat,
                      par.prior = TRUE,
                      prior.plots = FALSE)

# Filter to ensure matched samples between clinical and expression data
combat_expr <- combat_expr[, intersect(colnames(combat_expr), rownames(clinical))]
clinical <- clinical[intersect(rownames(clinical), colnames(combat_expr)), ]

# Convert relevant columns to factors
clinical$gender <- as.factor(clinical$gender)
clinical$vital_status <- as.factor(clinical$vital_status)
clinical$ajcc_pathologic_stage <- as.factor(clinical$ajcc_pathologic_stage)

# Subset matching expression data
combat_expr_filtered <- combat_expr[, rownames(clinical)]

```
```{r}

combat_expr_filtered <- combat_expr[, rownames(clinical)]

# Perform univariate Cox regression for each gene
combat_gene_pvals <- apply(combat_expr_filtered, 1, function(gene) {
  # Modified: skip genes with extremely low variance to prevent infinite coefficients
  if (sd(gene, na.rm = TRUE) < 1e-5) return(NA)  # Modified

  df <- data.frame(
    time = clinical$survival_time,
    status = clinical$event,
    gene = gene
  )
  tryCatch({
    coxph_res <- coxph(Surv(time, status) ~ gene, data = df, ties = "breslow")  # Modified: added ties = breslow
    summary(coxph_res)$coefficients["gene", "Pr(>|z|)"]
  }, error = function(e) NA)
})

# Select top 10 genes with smallest p-values
top_genes <- names(sort(combat_gene_pvals, na.last = NA))[1:10]
selected_expr <- scale(t(combat_expr_filtered[top_genes, ]))  # Modified: apply scaling to avoid high magnitude coefficients

# Combine clinical and gene expression data
cox_data <- cbind(clinical, selected_expr)
cox_data <- cox_data %>% select(-days_to_death, -age_at_diagnosis, -days_to_last_follow_up)

# Fit Cox model
cox_model <- coxph(Surv(survival_time, event) ~ ., data = cox_data, na.action = "na.exclude", ties = "breslow")  # Modified: added ties = breslow
summary(cox_model)

# Check proportional hazards assumption
cox.zph(cox_model)
