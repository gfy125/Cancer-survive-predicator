###Fit Cox Model
```{r}
# Create a data frame with gene expression data
gene_expr <- log_expr_filtered

# Perform univariate Cox regression for each gene
gene_pvals <- apply(gene_expr, 1, function(gene) {
  # Create a data frame with survival and gene expression data
  df <- data.frame(
    time = clinical$survival_time,
    status = clinical$event,
    gene = gene
  )
  
  # Fit the Cox model and extract the p-value for the gene
  tryCatch({
    coxph_res <- coxph(Surv(time, status) ~ gene, data = df)
    summary(coxph_res)$coefficients["gene", "Pr(>|z|)"]
  }, error = function(e) NA)  # Handle errors in case of failed fitting
})

# Sort genes by p-value (smallest p-value first)
top_20_genes_pvalue <- names(sort(gene_pvals, na.last = NA))[1:10]

# Filter gene expression data for these 20 genes
gene_expr_filtered <- gene_expr[top_20_genes_pvalue, ]

# Now, let's create a data frame with the relevant clinical data and batch-corrected expression
cox_data <- cbind(clinical, t(gene_expr_filtered))

cox_data <- cox_data %>%
  select(-days_to_death, -age_at_diagnosis,-vital_status)
```
```{r}
# Fit Cox model with clinical and gene expression data
cox_model_genes <- coxph(Surv(survival_time, event) ~ ., data = cox_data, na.action = "na.exclude")
```
```{r}
cox_summary <- summary(cox_model_genes)
```

```{r}
all_lp <- predict(cox_model_genes, type = "lp")

# Calculate relative hazard for each patient
all_relative_hazard <- exp(all_lp)

relative_hazard_df <- data.frame(relative_hazard = all_relative_hazard)
relative_hazard_df$log_transformed <- log10(relative_hazard_df$relative_hazard)


# Plot using ggplot
ggplot(relative_hazard_df, aes(x = relative_hazard)) +
  geom_histogram(binwidth = 0.2, fill = "lightblue", color = "black", alpha = 0.7) +
  labs(title = "Distribution of Relative Hazards (Training Patients)",
       x = "Relative Hazard", 
       y = "Frequency") +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 16, face = "bold"),
    axis.title = element_text(size = 12),
    axis.text = element_text(size = 10)
  ) 
```

