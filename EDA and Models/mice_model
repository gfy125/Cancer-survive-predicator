print_selected_gene_metrics <- function(selected_predictors_list) {
  if (is.null(selected_predictors_list) || length(selected_predictors_list) == 0) {
    num_selected_genes <- 0
    final_selected_genes <- character(0)
  } else {
    gene_counts <- sapply(selected_predictors_list, length)
    num_selected_genes <- if (length(gene_counts) == 0 || sum(gene_counts) == 0) 0 else round(mean(gene_counts, na.rm = TRUE))

    selected_predictor_counts <- table(unlist(selected_predictors_list))
    selected_predictor_counts <- sort(selected_predictor_counts, decreasing = TRUE)
    final_selected_genes <- names(selected_predictor_counts)
  }

  cat("Avg. # Selected Genes: ", num_selected_genes, "\n")
  cat("Top Selected Genes: ", if (length(final_selected_genes) == 0) "None" else paste(final_selected_genes[1:min(5, length(final_selected_genes))], collapse = ", "), "\n")
}

